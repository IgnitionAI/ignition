+@@ -0,0 +1,38 @@
++import { describe, expect, it } from 'vitest';
++import { createMetricsStore } from './store';
++import type { TrainingFrame } from './types';
++
++const frame = (episode: number, success: boolean): TrainingFrame => ({
++  episode,
++  reward: episode,
++  steps: 10,
++  success,
++});
++
++describe('createMetricsStore', () => {
++  it('calcule le taux de succès glissant sur la fenêtre', () => {
++    const store = createMetricsStore({ successWindow: 4 });
++    for (const s of [true, true, false, true]) store.getState().pushTrainingFrame(frame(1, s));
++    expect(store.getState().successRate).toBeCloseTo(0.75);
++    // La fenêtre glisse : on pousse un échec, le premier succès sort
++    store.getState().pushTrainingFrame(frame(5, false));
++    expect(store.getState().successRate).toBeCloseTo(0.5);
++  });
++
++  it('borne le nombre de frames conservées', () => {
++    const store = createMetricsStore({ maxFrames: 10 });
++    for (let i = 0; i < 25; i++) store.getState().pushTrainingFrame(frame(i, true));
++    expect(store.getState().trainingFrames).toHaveLength(10);
++    expect(store.getState().trainingFrames[0].episode).toBe(15);
++  });
++
++  it('reset vide les deux modes', () => {
++    const store = createMetricsStore();
++    store.getState().pushTrainingFrame(frame(1, true));
++    store.getState().pushInferenceFrame({ step: 0, action: 1 });
++    store.getState().reset();
++    expect(store.getState().trainingFrames).toHaveLength(0);
++    expect(store.getState().inferenceFrames).toHaveLength(0);
++    expect(store.getState().successRate).toBe(0);
++  });
++});
+diff --git a/packages/viz/src/store.ts b/packages/viz/src/store.ts
+new file mode 100644
+index 0000000..475cf22
+--- /dev/null
++++ b/packages/viz/src/store.ts
+@@ -0,0 +1,48 @@
++import { createStore, useStore } from 'zustand';
++import type { StoreApi } from 'zustand';
++import type { InferenceFrame, TrainingFrame } from './types';
++
++export interface MetricsState {
++  trainingFrames: TrainingFrame[];
++  inferenceFrames: InferenceFrame[];
++  /** Taux de succès glissant sur les `successWindow` derniers épisodes (0–1). */
++  successRate: number;
++  pushTrainingFrame: (frame: TrainingFrame) => void;
++  pushInferenceFrame: (frame: InferenceFrame) => void;
++  reset: () => void;
++}
++
++export type MetricsStore = StoreApi<MetricsState>;
++
++export interface MetricsStoreOptions {
++  /** Nombre max de frames conservées par mode (défaut 500). */
++  maxFrames?: number;
++  /** Fenêtre du taux de succès glissant (défaut 100 épisodes). */
++  successWindow?: number;
++}
++
++export function createMetricsStore(options: MetricsStoreOptions = {}): MetricsStore {
++  const maxFrames = options.maxFrames ?? 500;
++  const successWindow = options.successWindow ?? 100;
++
++  return createStore<MetricsState>((set, get) => ({
++    trainingFrames: [],
++    inferenceFrames: [],
++    successRate: 0,
++    pushTrainingFrame: (frame) => {
++      const frames = [...get().trainingFrames, frame].slice(-maxFrames);
++      const window = frames.slice(-successWindow);
++      const successRate = window.filter((f) => f.success).length / window.length;
++      set({ trainingFrames: frames, successRate });
++    },
++    pushInferenceFrame: (frame) => {
++      set({ inferenceFrames: [...get().inferenceFrames, frame].slice(-maxFrames) });
++    },
++    reset: () => set({ trainingFrames: [], inferenceFrames: [], successRate: 0 }),
++  }));
++}
++
++/** Hook React : sélecteur sur un store créé par `createMetricsStore`. */
++export function useMetrics<T>(store: MetricsStore, selector: (state: MetricsState) => T): T {
++  return useStore(store, selector);
++}
