{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@ignitionai/core": [
        "../core/src/index.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ]
}
