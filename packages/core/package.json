{
  "name": "@ignitionai/core",
  "version": "0.1.0",
  "description": "Core components for IgnitionAI - browser-based reinforcement learning framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/tests/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "reinforcement-learning",
    "agent",
    "environment",
    "browser",
    "tensorflow"
  ],
  "author": "salim4n (@IgnitionAI)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IgnitionAI/ignition"
  },
  "homepage": "https://github.com/IgnitionAI/ignition#readme",
  "dependencies": {
    "zod": "^3.24.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  }
}
