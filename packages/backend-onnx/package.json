{
  "name": "@ignitionai/backend-onnx",
  "version": "0.2.0",
  "description": "ONNX inference backend for IgnitionAI \u2014 cross-platform, production-ready RL inference",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/tests/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "dist/cjs/package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest --config ../../vitest.config.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "reinforcement-learning",
    "onnx",
    "inference",
    "onnxruntime",
    "dqn",
    "browser",
    "node"
  ],
  "author": "salim4n (@IgnitionAI)",
  "license": "MIT",
  "dependencies": {
    "@huggingface/hub": "^1.1.2",
    "@ignitionai/core": "workspace:*",
    "onnxruntime-common": "^1.17.0",
    "onnxruntime-node": "^1.17.0",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "onnxruntime-web": "^1.17.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ignitionai/backend-tfjs": "workspace:*",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "esbuild": "^0.28.0",
    "vitest": "^3.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/cjs/runtime.d.ts",
        "default": "./dist/cjs/runtime.js"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/runtime-universal.d.ts",
        "default": "./dist/runtime-universal.js"
      },
      "require": {
        "types": "./dist/cjs/runtime-universal.d.ts",
        "default": "./dist/cjs/runtime-universal.js"
      }
    }
  },
  "type": "module",
  "module": "dist/index.js"
}
