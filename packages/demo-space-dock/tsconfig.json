{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../web/*"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "@ignitionai/backend-tfjs": [
        "../backend-tfjs/src/index.ts"
      ],
      "@ignitionai/core": [
        "../core/src/index.ts"
      ],
      "@ignitionai/storage": [
        "../storage/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vite.config.ts"
  ]
}
