{
  "name": "@ignitionai/backend-tfjs",
  "version": "0.2.0",
  "description": "TensorFlow.js backend for IgnitionAI - browser-based reinforcement learning framework",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/tests/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "dist/cjs/package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest --config ../../vitest.config.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "reinforcement-learning",
    "tensorflow",
    "tfjs",
    "dqn",
    "ppo",
    "q-learning",
    "browser",
    "webgl",
    "webgpu"
  ],
  "author": "salim4n (@IgnitionAI)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IgnitionAI/ignition-monorepo-starter"
  },
  "homepage": "https://github.com/IgnitionAI/ignition-monorepo-starter#readme",
  "dependencies": {
    "@ignitionai/core": "workspace:*",
    "@ignitionai/storage": "workspace:*",
    "@huggingface/hub": "^1.1.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-vis": "^1.5.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "dotenv": "^16.5.0",
    "form-data": "^4.0.2",
    "vitest": "^3.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "type": "module"
}
