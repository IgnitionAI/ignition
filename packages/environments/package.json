{
  "name": "@ignitionai/environments",
  "version": "0.1.0",
  "description": "Reference training environments for IgnitionAI \u2014 GridWorld, CartPole, MountainCar",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/tests/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "dist/cjs/package.json"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@ignitionai/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgnitionAI/ignition.git"
  },
  "type": "module",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  }
}
